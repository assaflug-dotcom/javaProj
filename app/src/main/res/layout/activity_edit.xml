<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_edit"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etEditFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/first_name"
            android:inputType="textPersonName"
            android:autofillHints="given-name" />

        <EditText
            android:id="@+id/etEditLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/last_name"
            android:inputType="textPersonName"
            android:autofillHints="family-name" />

        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grade_title"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/rgEditGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEditGrade10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grade_10" />

            <RadioButton
                android:id="@+id/rbEditGrade11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grade_11" />

            <RadioButton
                android:id="@+id/rbEditGrade12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grade_12" />

        </RadioGroup>

        <TextView
            android:id="@+id/tvEditGradeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_grade"
            android:textColor="#B00020"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/major_title"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spEditMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvEditMajorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_major"
            android:textColor="#B00020"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cbEditNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications" />

        <CheckBox
            android:id="@+id/cbEditTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terms" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_cancel"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveReturn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save_return"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>